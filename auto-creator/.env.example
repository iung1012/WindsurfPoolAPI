# ── LuckMail (required) ────────────────────────────────────────────────────────
# Get your API key from: https://mails.luckyous.com → Account → API Keys
LUCKMAIL_API_KEY=your_api_key_here

# Project code for Windsurf on LuckMail.
# To find it: GET https://mails.luckyous.com/api/v1/openapi/projects
# Look for a project with "windsurf" or "codeium" in the name/code.
LUCKMAIL_PROJECT_CODE=windsurf

# ── WindsurfPoolAPI (required) ─────────────────────────────────────────────────
POOL_URL=https://windsurfpoolapi-production.up.railway.app
POOL_DASHBOARD_PASSWORD=

# ── Proxy (optional) ───────────────────────────────────────────────────────────
# Used for Windsurf account registration to avoid IP rate limits.
# Format: http://user:pass@host:port  or  socks5://user:pass@host:port
PROXY=http://pcthMrleVD-res-any:PC_1ArJlDI5itVGfNxoR@proxy-us.proxy-cheap.com:5959

# ── Scheduler tuning (optional) ────────────────────────────────────────────────
# Weekly request quota per free Windsurf account (tune based on observation).
QUOTA_PER_ACCOUNT=40

# Initial request-rate estimate (req/hour). Auto-adjusts based on real usage.
REQUESTS_PER_HOUR=5.0

# Safety buffer: 0.25 = keep 25% extra quota in reserve.
BUFFER_FACTOR=0.25

# Always maintain at least this many active accounts.
MIN_ACCOUNTS=2

# Maximum accounts to create in a single scheduler run.
MAX_CREATE_PER_RUN=5

# Delay between consecutive account creations (seconds).
CREATION_DELAY_SECONDS=15

# How often to check pool state and potentially create accounts (seconds).
# Default: 1800 = 30 minutes.
CHECK_INTERVAL_SECONDS=1800
